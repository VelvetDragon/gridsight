# MrGridy sponsor integrations. Copy to .env.local and fill in real values.
# Every integration degrades gracefully when its variable is empty.
# These are read on the server only (route handlers and pipeline scripts).
# Never put real keys in this file and never prefix them with NEXT_PUBLIC_.

# ElevenLabs: narration (pipeline/scripts/narrate.py) and the coordination call (POST /api/call).
# Sound effects need the key's sound_generation permission.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: a voice from your ElevenLabs voice library (defaults to a stock narrator voice)
ELEVENLABS_VOICE_ID=your-voice-id
# Optional: ElevenLabs model for narration (default eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: the two voices of the coordination call (defaults: stock "Matilda" and "Chris")
# ELEVENLABS_VOICE_DESC=
# ELEVENLABS_VOICE_GPC=

# Gemini API: /api/explain, /api/call, /api/utilities/find, gemini_check.py and the Spanish briefing.
# The utility finder's web search uses Grounding with Google Search (needs quota for it on this key).
GEMINI_API_KEY=your-gemini-api-key
# Optional: model override (default gemini-3.5-flash-lite, then gemini-3.8-flash, then gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Minimum gap between Gemini requests, in ms (default 1000). Raise it on the free tier.
# GEMINI_MIN_INTERVAL_MS=1000

# Tiger Data (Postgres + TimescaleDB): GET /api/outages, utilities found by /api/utilities/find,
# and pipeline/gridsight/integrations/tiger_load.py (outages, plan versions, catalog, overlaps, simulations).
# Use the service connection string from the Tiger console, including sslmode=require.
TIGER_DATABASE_URL=postgres://tsdbadmin:password@your-service.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
