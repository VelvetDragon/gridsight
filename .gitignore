# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling (kept local, never committed)
AGENTS.md
CLAUDE.md
.claude/

# python
__pycache__/
*.pyc
.venv*/
.ipynb_checkpoints/

# raw source data lives outside the repo (see pipeline/scripts/fetch_data.py)
pipeline/data/raw/
pipeline/data/cache/
